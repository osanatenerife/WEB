# ============================================================
# ENTORNO DE PRUEBA (osana-web-lab) — plantilla
#
# Copia este archivo como ".env.local" dentro de booking-api/ y rellena
# los valores TÚ, en tu ordenador. El archivo ".env.local" real NUNCA se
# sube a GitHub (ya está en .gitignore). Aquí no hay ningún valor real.
#
# REGLA DE ORO: todo lo de este archivo debe ser de PRUEBA y distinto del
# de producción. Crea una cuenta de servicio nueva, una Google Sheet nueva
# (vacía o con datos inventados) y calendarios de prueba. No reutilices
# nada de la web real.
# ============================================================

# --- Servidor -------------------------------------------------
# Puerto en el que arranca el backend en tu ordenador.
PORT=3001

# Dirección de la web de prueba (para los redirects de Stripe y CORS).
# En local, por ejemplo: http://localhost:8080
# NO pongas https://osana.es
FRONTEND_URL=http://localhost:8080

# --- Base de datos --------------------------------------------
# Dónde se guardan reservas, bonos, saldo...:
#   sheets   → Google Sheet (lo de siempre, valor por defecto)
#   supabase → Supabase (Fase 1, solo en pruebas)
DATA_BACKEND=supabase

# Supabase del proyecto de PRUEBA (Project Settings → API Keys / Data API).
# URL del proyecto, tipo https://abcdefghijkl.supabase.co
SUPABASE_URL=
# Clave SECRETA (empieza por sb_secret_). Da acceso total a los datos:
# solo aquí, nunca en la web, en GitHub ni en un chat.
SUPABASE_SECRET_KEY=

# Permiso para que tools/compare.js y tools/benchmark.js --cargar VACÍEN
# las tablas de Supabase y carguen datos inventados. Ponlo SOLO en el
# proyecto de prueba. Nunca en producción.
LAB_ALLOW_WIPE=si-borrar-todo

# --- Stripe (SOLO modo test) ----------------------------------
# Clave secreta de TEST (Dashboard de Stripe → activa "Modo de prueba" →
# Developers → API keys). Debe empezar por sk_test_. Si empieza por
# sk_live_, PARA: eso cobra dinero de verdad.
STRIPE_SECRET_KEY=sk_test_PON_AQUI_TU_CLAVE_DE_PRUEBA

# Firma del webhook de TEST. Para probar en local, instala Stripe CLI y
# ejecuta "stripe listen --forward-to localhost:3001/api/webhook/stripe":
# te enseña un whsec_... que va aquí.
STRIPE_WEBHOOK_SECRET=whsec_PON_AQUI_EL_SECRETO_DE_PRUEBA

# (Opcional) ID de configuración de métodos de pago de Stripe. Si lo dejas
# vacío se usan los métodos por defecto. En test, déjalo vacío.
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=

# --- Google (cuenta de servicio nueva, solo para pruebas) -----
# Contenido COMPLETO del JSON de la cuenta de servicio de PRUEBA, en una
# sola línea. Esa cuenta necesita permiso de Editor en la Sheet de prueba
# y en los calendarios de prueba. No uses la de producción.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID de la Google Sheet de PRUEBA (el código largo de la URL, entre /d/ y
# /edit). Es la "base de datos": usa una hoja nueva sin clientas reales.
# Con la hoja real, el backend leería y escribiría datos de clientas.
GOOGLE_SHEET_ID=

# (Opcional) Reseñas de Google en la portada. Puedes dejarlas vacías.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Panel interno --------------------------------------------
# Contraseña para entrar al panel (/api/panel/*). Invéntate una larga y
# distinta de la de producción. Sin ella el panel devuelve error.
PANEL_SECRET=

# --- Emails (Resend) ------------------------------------------
# Clave de Resend para enviar emails. Para pruebas puedes dejarla vacía
# (no se enviarán emails) o usar una clave de prueba tuya.
RESEND_API_KEY=
# Remitente de prueba. Resend permite este mientras no verifiques dominio.
RESEND_FROM_EMAIL=Osana Prueba <onboarding@resend.dev>

# ¡IMPORTANTE! Email que recibe los avisos internos (bonos, cancelaciones).
# Si lo dejas vacío, el código usa el email REAL del centro. Pon aquí tu
# propio email de pruebas.
GIFT_NOTIFY_EMAIL=

# Código de descuento que sale en el email de cumpleaños (opcional).
BIRTHDAY_PROMO_CODE=PRUEBA15

# --- Recordatorios automáticos --------------------------------
# Contraseña propia para llamar al endpoint de recordatorios. Inventa una
# larga, distinta de la de producción.
REMINDER_CRON_SECRET=

# --- WhatsApp (Twilio) — dejar VACÍO en pruebas ---------------
# Si se dejan vacías, la web funciona igual y solo se usa el email.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_REMINDER_TEMPLATE_SID=
# ¡IMPORTANTE! Teléfono que recibe avisos de WhatsApp. Si lo dejas vacío,
# el código usa el teléfono REAL de la dueña. Pon el tuyo, o déjalo vacío
# solo si Twilio también está vacío.
OWNER_PHONE=

# --- Auditoría de la Sheet (Fase 2, paso 1) -------------------
# ID de la COPIA de la Google Sheet real (el código entre /d/ y /edit en
# la URL). Nunca el de la hoja que usa la web.
AUDIT_SHEET_ID=
# Ruta al archivo JSON de la cuenta de servicio de auditoría (solo
# lectura). Déjalo FUERA del repositorio, p. ej. en Descargas.
AUDIT_SA_KEY_FILE=

# Modo solo lectura para la ventana del cambio de base de datos (docs/FASE2-PLAN.md, paso 5).
# 1 = no se acepta ninguna escritura. Vacío o ausente = normal.
DATA_READONLY=
