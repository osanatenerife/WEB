# Copia este archivo como ".env" en local para probar, o configura estas
# mismas variables en el panel de Render (Environment) al desplegar.
# NUNCA subas el archivo ".env" real a GitHub.

# Clave secreta de Stripe (Dashboard → Developers → API keys)
# Empieza probando con la de TEST (sk_test_...) antes de pasar a la real (sk_live_...)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Firma del webhook de Stripe (se genera al crear el endpoint del webhook,
# ver SETUP.md paso 5)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Contenido COMPLETO del archivo JSON de la cuenta de servicio de Google
# (todo en una sola línea). Ver SETUP.md paso 2.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# URL pública de tu web (para los redirects de Stripe y CORS)
FRONTEND_URL=https://osana.es

# Clave de API de Google Places (Google Cloud Console → APIs y servicios →
# Credenciales), restringida solo a "Places API". Se usa para traer las
# reseñas reales de Google en el home.
GOOGLE_PLACES_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Place ID de la ficha de Osana en Google (developers.google.com/maps/documentation/places/web-service/place-id)
GOOGLE_PLACE_ID=ChIJxxxxxxxxxxxxxxxxxxxxxxx

# ID de la Google Sheet donde se registran las reservas confirmadas (para
# "Mis reservas"). Es el código largo que aparece en la URL de la hoja,
# entre /d/ y /edit. Comparte la hoja con la cuenta de servicio (Editor).
GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clave de API de Resend (resend.com → API Keys) para enviar los
# recordatorios de cita por email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remitente de los emails. Con el dominio osana.es verificado en Resend,
# usa algo como: Osana <citas@osana.es>. Sin verificar, deja el de prueba.
RESEND_FROM_EMAIL=Osana <onboarding@resend.dev>

# Contraseña secreta propia (invéntatela) que solo tú y el disparador
# externo (GitHub Actions) conocéis, para que nadie más pueda llamar al
# endpoint de recordatorios.
REMINDER_CRON_SECRET=inventate-una-clave-larga-aqui

PORT=3001
