# Copia este archivo como ".env" en local para probar, o configura estas
# mismas variables en el panel de Render (Environment) al desplegar.
# NUNCA subas el archivo ".env" real a GitHub.

# Clave secreta de Stripe (Dashboard → Developers → API keys)
# Empieza probando con la de TEST (sk_test_...) antes de pasar a la real (sk_live_...)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Firma del webhook de Stripe (se genera al crear el endpoint del webhook,
# ver SETUP.md paso 5)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Contenido COMPLETO del archivo JSON de la cuenta de servicio de Google
# (todo en una sola línea). Ver SETUP.md paso 2.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# URL pública de tu web (para los redirects de Stripe y CORS)
FRONTEND_URL=https://osana.es

PORT=3001
